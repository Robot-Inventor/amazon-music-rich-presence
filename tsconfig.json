{
    "extends": ["./.hutch/devkit/tsconfig.json", "@robot-inventor/tsconfig-base/react.json"],
    "compilerOptions": {
        "rootDir": ".",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["bun"],
        "ignoreDeprecations": "6.0",
        "declaration": false,
        "exactOptionalPropertyTypes": false,
        "noImplicitReturns": false,
        "baseUrl": null
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts", "hutch.config.ts", "electrobun.config.ts"],
    "exclude": ["src/**/*.test.ts"]
}
