{
    "extends": ["./.hutch/devkit/tsconfig.json", "@robot-inventor/tsconfig-base/react-emotion.json"],
    "compilerOptions": {
        "rootDir": ".",
        "jsx": "react-jsx",
        "jsxImportSource": null,
        "types": ["bun"],
        "ignoreDeprecations": "6.0",
        "declaration": false,
        "exactOptionalPropertyTypes": false,
        "noImplicitReturns": false
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "hutch.config.ts", "electrobun.config.ts"],
    "exclude": ["src/**/*.test.ts"]
}
